# Copy this file to .env and fill in the values.
# .env is listed in .gitignore and will NOT be committed.

# Required: your Flipp API token (see README.md for how to obtain one)
FLIPP_TOKEN=

# Optional tweaks
FLIPP_TZ=Europe/Stockholm   # timezone the UI renders timestamps in
FLIPP_POLL_INTERVAL=360     # minutes between API polls (default 6 h)
FLIPP_WORKERS=4             # parallel PDF-page downloads per issue

# Change this to a long random string before exposing to the internet
FLIPP_SECRET_KEY=change-me-in-production

# Optional: set a password to enable the login screen
# Leave empty to disable authentication (for trusted-network deployments)
FLIPP_PASSWORD=
