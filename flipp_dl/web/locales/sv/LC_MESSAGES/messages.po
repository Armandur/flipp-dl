msgstr "vilar"

#: flipp_dl/web/routes.py:66
msgid "Use only characters that are valid in a folder name."
msgstr "Använd bara tecken som är giltiga i ett katalognamn."

#: flipp_dl/web/routes.py:67
msgid "That folder name is already used by another publication."
msgstr "Det katalognamnet används redan av en annan publikation."

#: flipp_dl/web/routes.py:68
msgid "The downloaded files could not be moved."
msgstr "De nedladdade filerna kunde inte flyttas."

#: flipp_dl/web/routes.py:69
msgid "No Flipp token is configured, so there is nothing to poll with."
msgstr "Ingen Flipp-token är konfigurerad, så det finns inget att polla med."

#: flipp_dl/web/routes.py:71
msgid ""
"Destination cannot be changed because this publication already has "
"downloaded issues."
msgstr ""
"Destinationen kan inte ändras eftersom publikationen redan har nedladdade"
" utgåvor."

#: flipp_dl/web/routes.py:74
msgid ""
"That folder does not exist. Create it first, or pick one with the browse "
"button."
msgstr "Den mappen finns inte. Skapa den först, eller välj en med bläddra-knappen."

#: flipp_dl/web/routes.py:84
msgid ""
"the address did not respond. Check that the URL is correct and that Komga"
" is running."
msgstr "adressen svarade inte. Kontrollera att URL:en stämmer och att Komga körs."

#: flipp_dl/web/routes.py:87
msgid "the login was rejected. Check the username, password or API key."
msgstr "inloggningen nekades. Kontrollera användarnamn, lösenord eller API-nyckel."

#: flipp_dl/web/routes.py:89
msgid ""
"the address responded, but the content doesn't look like it came from "
"Komga."
msgstr "adressen svarade, men innehållet verkar inte komma från Komga."

#: flipp_dl/web/routes.py:92
msgid "something went wrong. Check the address and try again."
msgstr "något gick fel. Kontrollera adressen och försök igen."

#: flipp_dl/web/codes_routes.py:54
msgid "The file could not be read - it is not valid JSON."
msgstr "Filen gick inte att läsa - den innehåller inte giltig JSON."

#: flipp_dl/web/codes_routes.py:56
msgid ""
"This does not look like a catalogue file (expected a list of "
"publications)."
msgstr ""
"Det här ser inte ut som en katalogfil (en lista med publikationer "
"förväntades)."

#: flipp_dl/web/codes_routes.py:59
msgid ""
"This does not look like a backup file (expected an object with "
"publications and issues)."
msgstr ""
"Det här ser inte ut som en säkerhetskopia (ett objekt med publikationer "
"och utgåvor förväntades)."

#: flipp_dl/web/codes_routes.py:62
msgid "No file was selected."
msgstr "Ingen fil valdes."

#: flipp_dl/web/codes_routes.py:63
msgid "The file is too large."
msgstr "Filen är för stor."

#: flipp_dl/web/codes_routes.py:64
msgid "The file contains no editions."
msgstr "Filen innehåller inga utgåvor."

